FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src ./src

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1

# Example: docker run alpharl-training python -m src.data_pipeline.pipeline
# Example: docker run alpharl-training python -m src.agent.train --ticker AAPL --timesteps 200000
ENTRYPOINT ["python"]
CMD ["-m", "src.data_pipeline.pipeline"]
