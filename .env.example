# ---- AlphaRL environment variables ----
# Copy this file to .env and fill in real values. Never commit .env.

# FRED API (macro indicators: VIX, yield curve). Get a free key at
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# NewsAPI (financial news headlines used for FinBERT sentiment). Get a free
# key at https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key_here

# --- LLM reasoning layer (explains why each trade was made) ---
# Default is "ollama" -- 100% free, runs locally, no API key needed.
# Install Ollama from https://ollama.com, then `ollama pull llama3.1`.
REASONING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Only needed if you set REASONING_PROVIDER=claude (paid, hosted). Get a key
# at https://console.anthropic.com/settings/keys. Leave unset to stay free.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional: Alpaca paper-trading keys, only needed if you wire up live/paper
# execution later. https://alpaca.markets
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ---- App config ----
TICKERS=AAPL,MSFT,SPY
START_DATE=2018-01-01
END_DATE=2024-12-31
INITIAL_CASH=100000

MLFLOW_TRACKING_URI=http://localhost:5000
LOG_LEVEL=INFO
